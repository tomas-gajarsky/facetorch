  "conditions": [
    "Retain Torch 2.6 through 2.13 and recommend the qualified Torch 2.13 pair for new installations.",
    "Use affected runtimes only with trusted model programs and metadata; never treat weights_only or artifact hashes as a sandbox for adversarial model uploads.",
    "Keep built-in hash verification enabled and default model compilation disabled.",
    "Custom models, compiler options and application-selected files require their own qualification and trust controls.",
    "Review upstream backports and advisory corrections before expiry; no automatic renewal."
  ],
  "authorization_excludes": [
    "push",
    "merge",
    "model publication",
    "image publication",
    "package publication",
    "GA release"
