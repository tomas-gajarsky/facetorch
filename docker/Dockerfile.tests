FROM python:3.12-slim

# Set working directory
ENV WORKDIR=/opt/facetorch
WORKDIR $WORKDIR

# Install base utilities
RUN apt-get update && apt-get install -y \
    git \
    build-essential && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# The source checkout is bind-mounted with the host user's ownership in CI.
# Trust only that exact mount so provenance and release-contract checks can read Git.
RUN git config --system --add safe.directory "$WORKDIR"

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.9.14 /uv /uvx /bin/

# Place venv outside WORKDIR so volume mounts don't hide it
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPYCACHEPREFIX=/tmp/facetorch_pycache
ENV FACETORCH_TEST_MODEL_ROOT=/tmp/facetorch_models
ENV COVERAGE_FILE=/tmp/facetorch_coverage

# Copy project files for dependency resolution
COPY pyproject.toml uv.lock README.md ./
COPY facetorch/ facetorch/

# Install all dependencies from lock file
RUN uv sync --frozen --extra dev

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="$WORKDIR/"
