FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Set working directory
ENV WORKDIR=/opt/facetorch
WORKDIR $WORKDIR

# Install base utilities and Python 3.12
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# GPU PyTorch index
ENV UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu124
ENV UV_PYTHON=python3.12
# Place venv outside WORKDIR so volume mounts don't hide it
ENV UV_PROJECT_ENVIRONMENT=/opt/venv

# Copy project files for dependency resolution
COPY pyproject.toml uv.lock README.md ./
COPY facetorch/ facetorch/

# Install all dependencies (re-resolves with GPU index)
RUN uv sync --extra dev

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="$WORKDIR/"
