FROM nvidia/cuda:13.3.1-runtime-ubuntu22.04

# Set working directory
ENV WORKDIR=/opt/facetorch
WORKDIR $WORKDIR

# Install base utilities and Python 3.12
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    software-properties-common && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.9.14 /uv /uvx /bin/

ENV UV_PYTHON=python3.12
# Place venv outside WORKDIR so volume mounts don't hide it
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPYCACHEPREFIX=/tmp/facetorch_pycache
ENV FACETORCH_TEST_MODEL_ROOT=/tmp/facetorch_models
ENV COVERAGE_FILE=/tmp/facetorch_coverage

# Install the exact CUDA 12.4 profile. Source is provided by the compose mount.
COPY environments/torch-2.6-cu124/pyproject.toml /opt/facetorch-profile/pyproject.toml
COPY environments/torch-2.6-cu124/uv.lock /opt/facetorch-profile/uv.lock
RUN uv sync --project /opt/facetorch-profile --frozen --extra test --python python3.12

ENV PATH="/opt/facetorch-profile/.venv/bin:$PATH"
ENV PYTHONPATH="$WORKDIR/"
